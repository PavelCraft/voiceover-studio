msgstr "Подготавливаем аудио"

msgid "Recognizing speech with Groq"
msgstr "Распознаём речь с помощью Groq"

msgid "Matching phrases with recognized words"
msgstr "Сопоставляем фразы с распознанными словами"

msgid "Detecting pauses"
msgstr "Ищем паузы"

msgid "Cutting and fitting fragments"
msgstr "Нарезаем и подгоняем фрагменты"

msgid "Rendering the result with FFmpeg"
msgstr "Собираем результат с помощью FFmpeg"

msgid "Files uploaded. You can start processing."
msgstr "Файлы загружены. Можно запускать обработку."

msgid "Processing started. You may leave this page and return later."
msgstr "Обработка запущена. Можно покинуть эту страницу и вернуться позже."

msgid "Processing is already running."
msgstr "Обработка уже выполняется."

msgid "Process and review the fragments first."
msgstr "Сначала обработайте и проверьте фрагменты."

msgid "Final rendering started. You may leave this page and return later."
msgstr "Финальная сборка запущена. Можно покинуть эту страницу и вернуться позже."

msgid "Select an audio file to replace the fragment."
msgstr "Выберите аудиофайл для замены фрагмента."

