msgstr "Выберите начало и конец фразы."

msgid "The selected phrase boundaries are invalid."
msgstr "Выбранные границы фразы некорректны."

msgid "Wait until project processing is complete before deleting it."
msgstr "Дождитесь окончания обработки проекта перед удалением."

msgid "The project and all its files were deleted."
msgstr "Проект и все его файлы удалены."

msgid "Checking the uploaded files"
msgstr "Проверяем загруженные файлы"

msgid "Combining video and audio with FFmpeg"
msgstr "Объединяем видео и аудио с помощью FFmpeg"

