[Unit]
Description=Voiceover Studio media worker
After=network-online.target voiceover-studio-web.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/voiceover-studio
EnvironmentFile=/etc/voiceover-studio.env
ExecStart=/var/www/voiceover-studio/.venv/bin/python manage.py run_voiceover_worker --poll 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/voiceover-studio
MemoryHigh=600M
MemoryMax=750M

[Install]
WantedBy=multi-user.target
